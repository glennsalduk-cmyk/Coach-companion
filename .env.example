# Copie ce fichier en `.env` et renseigne les valeurs de ton projet Supabase
# (Project Settings → API dans le dashboard Supabase).
#
# Ces variables doivent être préfixées par EXPO_PUBLIC_ pour être accessibles
# côté client avec Expo — ce sont des valeurs publiques par design (protégées
# par les policies RLS côté base de données, jamais par leur confidentialité).

EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
